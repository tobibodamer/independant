<?xml version="1.0" encoding="utf-8"?>
<!-- The PendantGlyph from Wordmark.kt (bail ring + hanging stone), scaled into
     the adaptive-icon safe zone. Same geometry and colors as the in-app glyph:
     ink #E8EAF2 for the metal, primary #9BB8FF for the stone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Bail: the small ring the chain would run through. -->
    <path
        android:strokeColor="#E8EAF2"
        android:strokeWidth="4.28"
        android:fillColor="#00000000"
        android:pathData="M54,30.47 m-7.13,0 a7.13,7.13 0 1,0 14.26,0 a7.13,7.13 0 1,0 -14.26,0" />
    <!-- Connector between bail and stone. -->
    <path
        android:strokeColor="#E8EAF2"
        android:strokeWidth="3.92"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,37.6 L54,44.02" />
    <!-- Stone: a kite-shaped gem hanging from the bail. -->
    <path
        android:fillColor="#9BB8FF"
        android:pathData="M54,42.59 L76.82,61.13 L54,86.8 L31.18,61.13 Z" />
</vector>
